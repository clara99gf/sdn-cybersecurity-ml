# Entorno virtual
venv/
.venv/

# Python
__pycache__/
*.pyc
*.pyo

# Empaquetado (pip install -e .)
*.egg-info/
*.egg-link
build/
dist/
.eggs/

# Datos generados
# data/dataset_sdn.csv se versiona (ver "Ficheros versionados" en el README).
data/processed/*
!data/processed/.gitkeep
# Copias del dataset con marca de tiempo (ARCHIVE_PREVIOUS_DATASET)
data/dataset_sdn_*.csv

# Modelos entrenados: se regeneran con ml/run_02_ml.py
models/*
!models/.gitkeep

# Ficheros de coordinación en tiempo de ejecución
runtime/*
!runtime/.gitkeep

# Log del generador de la fase 1 sin comprimir (supera el límite de
# GitHub); se versiona comprimido como traffic_generator.log.gz
logs/traffic_generator.log

# Capturas de tráfico
*.pcap

# Editores / SO
.vscode/
.idea/
.DS_Store
*.swp
.ipynb_checkpoints/
